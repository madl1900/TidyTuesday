# Using R
# Option 1: tidytuesdayR R package
## install.packages("tidytuesdayR")
# Option 2: Read directly from GitHub
fiction_citations <- readr::read_csv('https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2026/2026-11-10/fiction_citations.csv')
fiction_deaths <- readr::read_csv('https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2026/2026-11-10/fiction_deaths.csv')
fiction_rankings <- readr::read_csv('https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2026/2026-11-10/fiction_rankings.csv')
library(tidyverse)
library(mosaic)
top_killers <- fiction_deaths %>%
group_by(franchise_slug, killer) %>%
summarise(victim_num = n(), .groups = "drop") %>%
group_by(franchise_slug) %>%
slice_max(victim_num, n = 1, with_ties = TRUE)
reversed_kills <- top_killers %>%
left_join(fiction_deaths, by = "killer") %>%
group_by(killer) %>%
mutate(reversed_count = sum(undone))
ggplot(reversed_kills, aes(x = killer, y = victim_num)) +
geom_col() +
facet_wrap(~franchise_slug.x)
?facet_wrap
ggplot(reversed_kills, aes(x = killer, y = victim_num)) +
geom_col() +
facet_wrap(~franchise_slug.x, ncol = 3)
ggplot(reversed_kills, aes(x = killer, y = victim_num)) +
geom_col() +
facet_wrap(~franchise_slug.x, ncol = 2)
ggplot(reversed_kills, aes(x = killer, y = victim_num)) +
geom_col() +
facet_wrap(~franchise_slug.x)
