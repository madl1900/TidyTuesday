filtered_permits <- permits %>%
filter(variable == "Single Family") %>%
mutate(
state = str_pad(as.character(state), width = 2, pad = "0"),
county = str_pad(as.character(county), width = 3, pad = "0"),
year_groups = case_when(
year %in% 1980:1989 ~ "1980s",
year %in% 1990:1999 ~ "1990s",
year %in% 2000:2009 ~ "2000s",
year == 2010 ~ "2010"
)
)
# states
cont_states <- us_states() %>%
filter(
!(state_name %in% c("Alaska", "Hawaii", "Puerto Rico", "District of Columbia"))
)
state_permits <- cont_states %>%
left_join(filtered_permits, by = c("statefp" = "state"))
state_totals <- state_permits %>%
group_by(statefp) %>%
mutate(state_total = max(value))
year_totals <- state_totals %>%
group_by(statefp, year_groups) %>%
mutate(year_percent = (value/state_total)*100)
# countys
wi_permits <- filtered_permits %>%
filter(StateAbbr == "WI")
wi <- us_counties(state = "Wisconsin") %>%
left_join(wi_permits, by = c("countyfp" = "county"))
class(wi)
county_totals <- wi %>%
group_by(countyfp) %>%
mutate(county_total = max(value))
wi_year_totals <- county_totals %>%
group_by(countyfp, year_groups) %>%
mutate(county_percent = (value/county_total)*100)
ggplot(year_totals, aes(geometry = geometry, fill = year_percent)) +
geom_sf() +
facet_wrap(~year_groups) +
scale_fill_gradient(low = "lightblue", high = "darkblue", name = "Permit \nPercentage") +
theme_bw() +
labs(
title = "Single Family Permits in the U.S. were at a Low in the 1990s",
subtitle = "Based on a percentage of the max per state"
) +
theme(
axis.text = element_text(size = 6.5)
)
